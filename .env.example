# Comma-separated browser origins allowed to call the local API.
VEILSIGHT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Request-size guard; source media is processed in memory/temp space and never persisted.
VEILSIGHT_MAX_UPLOAD_BYTES=26214400
# Optional local model overrides.
# VEILSIGHT_MEDIAPIPE_MODEL=models/blaze_face_short_range.tflite
# VEILSIGHT_YOLO_MODEL=models/yolov11n-face.pt
